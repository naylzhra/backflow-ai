# Environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
.venv-ml/
venv/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ML model artifacts and caches (never commit weights or training state).
# Exception: final exported artifacts ARE committed so `docker compose up` runs
# clean without downloads (see docs/decisions.md D8).
*.pkl
*.onnx
*.joblib
*.pt
*.bin
.huggingface/
.cache/huggingface/
data/processed/
!backend/app/models/artifacts/*.pkl
!backend/app/models/artifacts/*.onnx
!backend/app/models/artifacts/manifest.json
!backend/app/models/artifacts/embedding_config.json
!backend/tests/fixtures/**/*.onnx
!backend/tests/fixtures/**/*.json

# IDE, OS, coverage, and builds
.idea/
.vscode/
.DS_Store
Thumbs.db
.coverage
htmlcov/
dist/
build/
scratch/

